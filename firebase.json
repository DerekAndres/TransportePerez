{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "transporte-web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  }
}
