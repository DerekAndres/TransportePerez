{
  "expo": {
    "name": "transporte-movil",
    "slug": "transporte-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "transportemovil",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.derekperez.transporteperez",
      "supportsTablet": true
    },
    "android": {
      "package": "com.derekperez.transporteperez",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F131D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa tu ubicación durante el viaje para que los padres vean el bus en tiempo real, y para marcar en el mapa el lugar donde se recoge a tu hijo.",
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0F131D",
          "dark": {
            "backgroundColor": "#0F131D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9971d4f8-33e6-48a3-a03a-6cbc76fda9ca"
      }
    },
    "owner": "derekk300"
  }
}
